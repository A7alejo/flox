# Conexión a PostgreSQL (Supabase)
# En Supabase: botón Connect > "Session pooler" (host *.pooler.supabase.com).
# No usar la conexión directa (db.*.supabase.co): es solo IPv6 y Render no la alcanza.
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Supabase en Render requiere SSL. Dejar en "true" salvo que conectes
# a una base local sin SSL.
DB_SSL=true

# Opcional (recomendado en producción): certificado de Supabase para verificar
# la conexión. Project Settings > Database > SSL Configuration > Download
# certificate, y pegar el contenido completo (puede ir con \n en vez de saltos).
DB_SSL_CA=

# Puerto del servidor (Render lo inyecta automáticamente en producción,
# esta variable se usa para desarrollo local)
PORT=4000

# Orígenes permitidos para CORS, separados por coma. Con el proxy de Vercel
# el navegador no hace pedidos entre dominios, pero se deja la lista igual.
CORS_ORIGINS=http://localhost:5173,https://floxer.vercel.app

# "production" en Render -> cookies Secure (solo HTTPS) y DB_SSL obligatorio
# (vacío o "development" en local -> cookies sin Secure). SameSite=Lax siempre.
NODE_ENV=development

# Secreto para firmar los JWT. OBLIGATORIO y debe ser largo y aleatorio.
# Generarlo con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Nunca reutilizar un valor de ejemplo ni subirlo a git.
JWT_SECRET=

# Duración de la sesión (formato de la librería jsonwebtoken: "24h", "7d", etc.).
# La cookie vence junto con el token.
JWT_EXPIRES_IN=24h

# Nombre de la cookie donde viaja el JWT
COOKIE_NAME=flox_token
