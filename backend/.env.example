# Conexión a PostgreSQL (Supabase)
# En Supabase: Project Settings > Database > Connection string (modo "Transaction" o "Session")
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Supabase en Render requiere SSL. Dejar en "true" salvo que conectes
# a una base local sin SSL.
DB_SSL=true

# Puerto del servidor (Render lo inyecta automáticamente en producción,
# esta variable se usa para desarrollo local)
PORT=4000

# Orígenes permitidos para CORS, separados por coma
# (la URL del frontend desplegado en Vercel + localhost para desarrollo)
CORS_ORIGINS=http://localhost:5173,https://floxer.vercel.app

# "production" en Render -> activa cookies Secure + SameSite=None
# (vacío o "development" en local -> cookies sin Secure, SameSite=Lax)
NODE_ENV=development

# Secreto para firmar los JWT. OBLIGATORIO y debe ser largo y aleatorio.
# Generarlo con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Nunca reutilizar un valor de ejemplo ni subirlo a git.
JWT_SECRET=

# Duración de la sesión (formato de la librería jsonwebtoken: "24h", "7d", etc.).
# La cookie vence junto con el token.
JWT_EXPIRES_IN=24h

# Nombre de la cookie donde viaja el JWT
COOKIE_NAME=flox_token
